{"page":167,"juz":9,"verses":[{"key":"7:138","text":"وَجَـٰوَزْنَا بِبَنِىٓ إِسْرَٰٓءِيلَ ٱلْبَحْرَ فَأَتَوْا۟ عَلَىٰ قَوْمٍ يَعْكُفُونَ عَلَىٰٓ أَصْنَامٍ لَّهُمْ ۚ قَالُوا۟ يَـٰمُوسَى ٱجْعَل لَّنَآ إِلَـٰهًا كَمَا لَهُمْ ءَالِهَةٌ ۚ قَالَ إِنَّكُمْ قَوْمٌ تَجْهَلُونَ","words":[[1,"ﱁ","وَجَـٰوَزْنَا","word"],[1,"ﱂ","بِبَنِىٓ","word"],[1,"ﱃ","إِسْرَٰٓءِيلَ","word"],[1,"ﱄ","ٱلْبَحْرَ","word"],[1,"ﱅ","فَأَتَوْا۟","word"],[1,"ﱆ","عَلَىٰ","word"],[1,"ﱇ","قَوْمٍۢ","word"],[1,"ﱈ","يَعْكُفُونَ","word"],[2,"ﱉ","عَلَىٰٓ","word"],[2,"ﱊ","أَصْنَامٍۢ","word"],[2,"ﱋﱌ","لَّهُمْ ۚ","word"],[2,"ﱍ","قَالُوا۟","word"],[2,"ﱎ","يَـٰمُوسَى","word"],[2,"ﱏ","ٱجْعَل","word"],[2,"ﱐ","لَّنَآ","word"],[2,"ﱑ","إِلَـٰهًۭا","word"],[2,"ﱒ","كَمَا","word"],[3,"ﱓ","لَهُمْ","word"],[3,"ﱔﱕ","ءَالِهَةٌۭ ۚ","word"],[3,"ﱖ","قَالَ","word"],[3,"ﱗ","إِنَّكُمْ","word"],[3,"ﱘ","قَوْمٌۭ","word"],[3,"ﱙ","تَجْهَلُونَ","word"],[3,"ﱚ","١٣٨","end"]]},{"key":"7:139","text":"إِنَّ هَـٰٓؤُلَآءِ مُتَبَّرٌ مَّا هُمْ فِيهِ وَبَـٰطِلٌ مَّا كَانُوا۟ يَعْمَلُونَ","words":[[3,"ﱛ","إِنَّ","word"],[3,"ﱜ","هَـٰٓؤُلَآءِ","word"],[3,"ﱝ","مُتَبَّرٌۭ","word"],[4,"ﱞ","مَّا","word"],[4,"ﱟ","هُمْ","word"],[4,"ﱠ","فِيهِ","word"],[4,"ﱡ","وَبَـٰطِلٌۭ","word"],[4,"ﱢ","مَّا","word"],[4,"ﱣ","كَانُوا۟","word"],[4,"ﱤ","يَعْمَلُونَ","word"],[4,"ﱥ","١٣٩","end"]]},{"key":"7:140","text":"قَالَ أَغَيْرَ ٱللَّهِ أَبْغِيكُمْ إِلَـٰهًا وَهُوَ فَضَّلَكُمْ عَلَى ٱلْعَـٰلَمِينَ","words":[[4,"ﱦ","قَالَ","word"],[4,"ﱧ","أَغَيْرَ","word"],[4,"ﱨ","ٱللَّهِ","word"],[5,"ﱩ","أَبْغِيكُمْ","word"],[5,"ﱪ","إِلَـٰهًۭا","word"],[5,"ﱫ","وَهُوَ","word"],[5,"ﱬ","فَضَّلَكُمْ","word"],[5,"ﱭ","عَلَى","word"],[5,"ﱮ","ٱلْعَـٰلَمِينَ","word"],[5,"ﱯ","١٤٠","end"]]},{"key":"7:141","text":"وَإِذْ أَنجَيْنَـٰكُم مِّنْ ءَالِ فِرْعَوْنَ يَسُومُونَكُمْ سُوٓءَ ٱلْعَذَابِ ۖ يُقَتِّلُونَ أَبْنَآءَكُمْ وَيَسْتَحْيُونَ نِسَآءَكُمْ ۚ وَفِى ذَٰلِكُم بَلَآءٌ مِّن رَّبِّكُمْ عَظِيمٌ","words":[[5,"ﱰ","وَإِذْ","word"],[5,"ﱱ","أَنجَيْنَـٰكُم","word"],[6,"ﱲ","مِّنْ","word"],[6,"ﱳ","ءَال