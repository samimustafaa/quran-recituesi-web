{"page":108,"juz":6,"verses":[{"key":"5:6","text":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا قُمْتُمْ إِلَى ٱلصَّلَوٰةِ فَٱغْسِلُوا۟ وُجُوهَكُمْ وَأَيْدِيَكُمْ إِلَى ٱلْمَرَافِقِ وَٱمْسَحُوا۟ بِرُءُوسِكُمْ وَأَرْجُلَكُمْ إِلَى ٱلْكَعْبَيْنِ ۚ وَإِن كُنتُمْ جُنُبًا فَٱطَّهَّرُوا۟ ۚ وَإِن كُنتُم مَّرْضَىٰٓ أَوْ عَلَىٰ سَفَرٍ أَوْ جَآءَ أَحَدٌ مِّنكُم مِّنَ ٱلْغَآئِطِ أَوْ لَـٰمَسْتُمُ ٱلنِّسَآءَ فَلَمْ تَجِدُوا۟ مَآءً فَتَيَمَّمُوا۟ صَعِيدًا طَيِّبًا فَٱمْسَحُوا۟ بِوُجُوهِكُمْ وَأَيْدِيكُم مِّنْهُ ۚ مَا يُرِيدُ ٱللَّهُ لِيَجْعَلَ عَلَيْكُم مِّنْ حَرَجٍ وَلَـٰكِن يُرِيدُ لِيُطَهِّرَكُمْ وَلِيُتِمَّ نِعْمَتَهُۥ عَلَيْكُمْ لَعَلَّكُمْ تَشْكُرُونَ","words":[[1,"ﱁ","يَـٰٓأَيُّهَا","word"],[1,"ﱂ","ٱلَّذِينَ","word"],[1,"ﱃ","ءَامَنُوٓا۟","word"],[1,"ﱄ","إِذَا","word"],[1,"ﱅ","قُمْتُمْ","word"],[1,"ﱆ","إِلَى","word"],[1,"ﱇ","ٱلصَّلَوٰةِ","word"],[1,"ﱈ","فَٱغْسِلُوا۟","word"],[2,"ﱉ","وُجُوهَكُمْ","word"],[2,"ﱊ","وَأَيْدِيَكُمْ","word"],[2,"ﱋ","إِلَى","word"],[2,"ﱌ","ٱلْمَرَافِقِ","word"],[2,"ﱍ","وَٱمْسَحُوا۟","word"],[2,"ﱎ","بِرُءُوسِكُمْ","word"],[3,"ﱏ","وَأَرْجُلَكُمْ","word"],[3,"ﱐ","إِلَى","word"],[3,"ﱑﱒ","ٱلْكَعْبَيْنِ ۚ","word"],[3,"ﱓ","وَإِن","word"],[3,"ﱔ","كُنتُمْ","word"],[3,"ﱕ","جُنُبًۭا","word"],[3,"ﱖﱗ","فَٱطَّهَّرُوا۟ ۚ","word"],[4,"ﱘ","وَإِن","word"],[4,"ﱙ","كُنتُم","word"],[4,"ﱚ","مَّرْضَىٰٓ","word"],[4,"ﱛ","أَوْ","word"],[4,"ﱜ","عَلَىٰ","word"],[4,"ﱝ","سَفَرٍ","word"],[4,"ﱞ","أَوْ","word"],[4,"ﱟ","جَآءَ","word"],[4,"ﱠ","أَحَدٌۭ","word"],[4,"ﱡ","مِّنكُم","word"],[4,"ﱢ","مِّنَ","word"],[5,"ﱣ","ٱلْغَآئِطِ","word"],[5,"ﱤ","أَوْ","word"],[5,"ﱥ","لَـٰمَسْتُمُ","word"],[5,"ﱦ","ٱلنِّسَآءَ","word"],[5,"ﱧ","فَلَمْ","word"],[5,"ﱨ","تَجِدُوا۟","word"],[5,"ﱩ","مَآءًۭ","word"],[5,"ﱪ","فَتَيَمَّمُوا۟","word"],[5,"ﱫ","صَعِيدًۭا","word"],[6,"ﱬ","طَيِّبًۭا","word"],[6,"ﱭ","فَٱمْسَحُوا۟","word"],[6,"ﱮ","بِوُجُوهِكُمْ","word"],[6,"ﱯ","وَأَيْدِيكُم","word"],[6,"ﱰﱱ","مِّنْهُ ۚ","word"],[6,"ﱲ","مَا","word"],[6,"ﱳ","يُرِيدُ","word"],[6,"ﱴ","ٱللَّهُ","word"],[7,"ﱵ","لِيَجْعَلَ"