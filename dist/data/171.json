{"page":171,"juz":9,"verses":[{"key":"7:160","text":"وَقَطَّعْنَـٰهُمُ ٱثْنَتَىْ عَشْرَةَ أَسْبَاطًا أُمَمًا ۚ وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ إِذِ ٱسْتَسْقَىٰهُ قَوْمُهُۥٓ أَنِ ٱضْرِب بِّعَصَاكَ ٱلْحَجَرَ ۖ فَٱنۢبَجَسَتْ مِنْهُ ٱثْنَتَا عَشْرَةَ عَيْنًا ۖ قَدْ عَلِمَ كُلُّ أُنَاسٍ مَّشْرَبَهُمْ ۚ وَظَلَّلْنَا عَلَيْهِمُ ٱلْغَمَـٰمَ وَأَنزَلْنَا عَلَيْهِمُ ٱلْمَنَّ وَٱلسَّلْوَىٰ ۖ كُلُوا۟ مِن طَيِّبَـٰتِ مَا رَزَقْنَـٰكُمْ ۚ وَمَا ظَلَمُونَا وَلَـٰكِن كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ","words":[[1,"ﱁ","وَقَطَّعْنَـٰهُمُ","word"],[1,"ﱂ","ٱثْنَتَىْ","word"],[1,"ﱃ","عَشْرَةَ","word"],[1,"ﱄ","أَسْبَاطًا","word"],[1,"ﱅﱆ","أُمَمًۭا ۚ","word"],[1,"ﱇ","وَأَوْحَيْنَآ","word"],[1,"ﱈ","إِلَىٰ","word"],[2,"ﱉ","مُوسَىٰٓ","word"],[2,"ﱊ","إِذِ","word"],[2,"ﱋ","ٱسْتَسْقَىٰهُ","word"],[2,"ﱌ","قَوْمُهُۥٓ","word"],[2,"ﱍ","أَنِ","word"],[2,"ﱎ","ٱضْرِب","word"],[2,"ﱏ","بِّعَصَاكَ","word"],[2,"ﱐﱑ","ٱلْحَجَرَ ۖ","word"],[3,"ﱒ","فَٱنۢبَجَسَتْ","word"],[3,"ﱓ","مِنْهُ","word"],[3,"ﱔ","ٱثْنَتَا","word"],[3,"ﱕ","عَشْرَةَ","word"],[3,"ﱖﱗ","عَيْنًۭا ۖ","word"],[3,"ﱘ","قَدْ","word"],[3,"ﱙ","عَلِمَ","word"],[3,"ﱚ","كُلُّ","word"],[3,"ﱛ","أُنَاسٍۢ","word"],[4,"ﱜﱝ","مَّشْرَبَهُمْ ۚ","word"],[4,"ﱞ","وَظَلَّلْنَا","word"],[4,"ﱟ","عَلَيْهِمُ","word"],[4,"ﱠ","ٱلْغَمَـٰمَ","word"],[4,"ﱡ","وَأَنزَلْنَا","word"],[4,"ﱢ","عَلَيْهِمُ","word"],[5,"ﱣ","ٱلْمَنَّ","word"],[5,"ﱤﱥ","وَٱلسَّلْوَىٰ ۖ","word"],[5,"ﱦ","كُلُوا۟","word"],[5,"ﱧ","مِن","word"],[5,"ﱨ","طَيِّبَـٰتِ","word"],[5,"ﱩ","مَا","word"],[5,"ﱪﱫ","رَزَقْنَـٰكُمْ ۚ","word"],[5,"ﱬ","وَمَا","word"],[6,"ﱭ","ظَلَمُونَا","word"],[6,"ﱮ","وَلَـٰكِن","word"],[6,"ﱯ","كَانُوٓا۟","word"],[6,"ﱰ","أَنفُسَهُمْ","word"],[6,"ﱱ","يَظْلِمُونَ","word"],[6,"ﱲ","١٦٠","end"]]},{"key":"7:161","text":"وَإِذْ قِيلَ لَهُمُ ٱسْكُنُوا۟ هَـٰذِهِ ٱلْقَرْيَةَ وَكُلُوا۟ مِنْهَا حَيْثُ شِئْتُمْ وَقُولُوا۟ حِطَّةٌ وَٱدْخُلُوا۟ ٱلْبَابَ سُجَّدًا نَّغْفِرْ لَكُمْ خَطِيٓـَٔـٰتِكُمْ ۚ سَنَزِيدُ ٱلْمُحْسِنِينَ","words":[[7,"ﱳ","وَإِذْ","word"],[7,"ﱴ","قِيلَ","word"],[7,"ﱵ","لَهُمُ","word"],[