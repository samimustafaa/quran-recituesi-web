{"page":37,"juz":2,"verses":[{"key":"2:231","text":"وَإِذَا طَلَّقْتُمُ ٱلنِّسَآءَ فَبَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ سَرِّحُوهُنَّ بِمَعْرُوفٍ ۚ وَلَا تُمْسِكُوهُنَّ ضِرَارًا لِّتَعْتَدُوا۟ ۚ وَمَن يَفْعَلْ ذَٰلِكَ فَقَدْ ظَلَمَ نَفْسَهُۥ ۚ وَلَا تَتَّخِذُوٓا۟ ءَايَـٰتِ ٱللَّهِ هُزُوًا ۚ وَٱذْكُرُوا۟ نِعْمَتَ ٱللَّهِ عَلَيْكُمْ وَمَآ أَنزَلَ عَلَيْكُم مِّنَ ٱلْكِتَـٰبِ وَٱلْحِكْمَةِ يَعِظُكُم بِهِۦ ۚ وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ بِكُلِّ شَىْءٍ عَلِيمٌ","words":[[1,"ﱁ","وَإِذَا","word"],[1,"ﱂ","طَلَّقْتُمُ","word"],[1,"ﱃ","ٱلنِّسَآءَ","word"],[1,"ﱄ","فَبَلَغْنَ","word"],[1,"ﱅ","أَجَلَهُنَّ","word"],[1,"ﱆ","فَأَمْسِكُوهُنَّ","word"],[1,"ﱇ","بِمَعْرُوفٍ","word"],[2,"ﱈ","أَوْ","word"],[2,"ﱉ","سَرِّحُوهُنَّ","word"],[2,"ﱊﱋ","بِمَعْرُوفٍۢ ۚ","word"],[2,"ﱌ","وَلَا","word"],[2,"ﱍ","تُمْسِكُوهُنَّ","word"],[2,"ﱎ","ضِرَارًۭا","word"],[2,"ﱏﱐ","لِّتَعْتَدُوا۟ ۚ","word"],[2,"ﱑ","وَمَن","word"],[3,"ﱒ","يَفْعَلْ","word"],[3,"ﱓ","ذَٰلِكَ","word"],[3,"ﱔ","فَقَدْ","word"],[3,"ﱕ","ظَلَمَ","word"],[3,"ﱖﱗ","نَفْسَهُۥ ۚ","word"],[3,"ﱘ","وَلَا","word"],[3,"ﱙ","تَتَّخِذُوٓا۟","word"],[3,"ﱚ","ءَايَـٰتِ","word"],[3,"ﱛ","ٱللَّهِ","word"],[3,"ﱜﱝ","هُزُوًۭا ۚ","word"],[4,"ﱞ","وَٱذْكُرُوا۟","word"],[4,"ﱟ","نِعْمَتَ","word"],[4,"ﱠ","ٱللَّهِ","word"],[4,"ﱡ","عَلَيْكُمْ","word"],[4,"ﱢ","وَمَآ","word"],[4,"ﱣ","أَنزَلَ","word"],[4,"ﱤ","عَلَيْكُم","word"],[4,"ﱥ","مِّنَ","word"],[4,"ﱦ","ٱلْكِتَـٰبِ","word"],[4,"ﱧ","وَٱلْحِكْمَةِ","word"],[5,"ﱨ","يَعِظُكُم","word"],[5,"ﱩﱪ","بِهِۦ ۚ","word"],[5,"ﱫ","وَٱتَّقُوا۟","word"],[5,"ﱬ","ٱللَّهَ","word"],[5,"ﱭ","وَٱعْلَمُوٓا۟","word"],[5,"ﱮ","أَنَّ","word"],[5,"ﱯ","ٱللَّهَ","word"],[5,"ﱰ","بِكُلِّ","word"],[5,"ﱱ","شَىْءٍ","word"],[5,"ﱲ","عَلِيمٌۭ","word"],[5,"ﱳ","٢٣١","end"]]},{"key":"2:232","text":"وَإِذَا طَلَّقْتُمُ ٱلنِّسَآءَ فَبَلَغْنَ أَجَلَهُنَّ فَلَا تَعْضُلُوهُنَّ أَن يَنكِحْنَ أَزْوَٰجَهُنَّ إِذَا تَرَٰضَوْا۟ بَيْنَهُم بِٱلْمَعْرُوفِ ۗ ذَٰلِكَ يُوعَظُ بِهِۦ مَن كَانَ مِنكُمْ يُؤْمِنُ بِٱللَّهِ وَٱلْيَوْمِ ٱل