{"page":151,"juz":8,"verses":[{"key":"7:1","text":" الٓمٓصٓ","words":[[3,"ﱁ","الٓمٓصٓ","word"],[3,"ﱂ","١","end"]]},{"key":"7:2","text":"كِتَـٰبٌ أُنزِلَ إِلَيْكَ فَلَا يَكُن فِى صَدْرِكَ حَرَجٌ مِّنْهُ لِتُنذِرَ بِهِۦ وَذِكْرَىٰ لِلْمُؤْمِنِينَ","words":[[3,"ﱃ","كِتَـٰبٌ","word"],[3,"ﱄ","أُنزِلَ","word"],[3,"ﱅ","إِلَيْكَ","word"],[3,"ﱆ","فَلَا","word"],[3,"ﱇ","يَكُن","word"],[3,"ﱈ","فِى","word"],[3,"ﱉ","صَدْرِكَ","word"],[3,"ﱊ","حَرَجٌۭ","word"],[3,"ﱋ","مِّنْهُ","word"],[4,"ﱌ","لِتُنذِرَ","word"],[4,"ﱍ","بِهِۦ","word"],[4,"ﱎ","وَذِكْرَىٰ","word"],[4,"ﱏ","لِلْمُؤْمِنِينَ","word"],[4,"ﱐ","٢","end"]]},{"key":"7:3","text":"ٱتَّبِعُوا۟ مَآ أُنزِلَ إِلَيْكُم مِّن رَّبِّكُمْ وَلَا تَتَّبِعُوا۟ مِن دُونِهِۦٓ أَوْلِيَآءَ ۗ قَلِيلًا مَّا تَذَكَّرُونَ","words":[[4,"ﱑ","ٱتَّبِعُوا۟","word"],[4,"ﱒ","مَآ","word"],[4,"ﱓ","أُنزِلَ","word"],[4,"ﱔ","إِلَيْكُم","word"],[5,"ﱕ","مِّن","word"],[5,"ﱖ","رَّبِّكُمْ","word"],[5,"ﱗ","وَلَا","word"],[5,"ﱘ","تَتَّبِعُوا۟","word"],[5,"ﱙ","مِن","word"],[5,"ﱚ","دُونِهِۦٓ","word"],[5,"ﱛﱜ","أَوْلِيَآءَ ۗ","word"],[5,"ﱝ","قَلِيلًۭا","word"],[5,"ﱞ","مَّا","word"],[5,"ﱟ","تَذَكَّرُونَ","word"],[6,"ﱠ","٣","end"]]},{"key":"7:4","text":"وَكَم مِّن قَرْيَةٍ أَهْلَكْنَـٰهَا فَجَآءَهَا بَأْسُنَا بَيَـٰتًا أَوْ هُمْ قَآئِلُونَ","words":[[6,"ﱡ","وَكَم","word"],[6,"ﱢ","مِّن","word"],[6,"ﱣ","قَرْيَةٍ","word"],[6,"ﱤ","أَهْلَكْنَـٰهَا","word"],[6,"ﱥ","فَجَآءَهَا","word"],[6,"ﱦ","بَأْسُنَا","word"],[6,"ﱧ","بَيَـٰتًا","word"],[6,"ﱨ","أَوْ","word"],[6,"ﱩ","هُمْ","word"],[7,"ﱪ","قَآئِلُونَ","word"],[7,"ﱫ","٤","end"]]},{"key":"7:5","text":"فَمَا كَانَ دَعْوَىٰهُمْ إِذْ جَآءَهُم بَأْسُنَآ إِلَّآ أَن قَالُوٓا۟ إِنَّا كُنَّا ظَـٰلِمِينَ","words":[[7,"ﱬ","فَمَا","word"],[7,"ﱭ","كَانَ","word"],[7,"ﱮ","دَعْوَىٰهُمْ","word"],[7,"ﱯ","إِذْ","word"],[7,"ﱰ","جَآءَهُم","word"],[7,"ﱱ","بَأْسُنَآ","word"],[7,"ﱲ","إِلَّآ","word"],[7,"ﱳ","أَن","word"],[7,"ﱴ","قَالُوٓا۟","word"],[8,"ﱵ","إِنَّا","word"],[8,"ﱶ","كُنَّا","word"],[8,"ﱷ","ظَـٰلِمِينَ","word"],[8,"ﱸ","٥","end"]