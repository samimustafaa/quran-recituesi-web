{"page":207,"juz":11,"verses":[{"key":"9:123","text":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ قَـٰتِلُوا۟ ٱلَّذِينَ يَلُونَكُم مِّنَ ٱلْكُفَّارِ وَلْيَجِدُوا۟ فِيكُمْ غِلْظَةً ۚ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ مَعَ ٱلْمُتَّقِينَ","words":[[1,"ﱁ","يَـٰٓأَيُّهَا","word"],[1,"ﱂ","ٱلَّذِينَ","word"],[1,"ﱃ","ءَامَنُوا۟","word"],[1,"ﱄ","قَـٰتِلُوا۟","word"],[1,"ﱅ","ٱلَّذِينَ","word"],[1,"ﱆ","يَلُونَكُم","word"],[1,"ﱇ","مِّنَ","word"],[1,"ﱈ","ٱلْكُفَّارِ","word"],[2,"ﱉ","وَلْيَجِدُوا۟","word"],[2,"ﱊ","فِيكُمْ","word"],[2,"ﱋﱌ","غِلْظَةًۭ ۚ","word"],[2,"ﱍ","وَٱعْلَمُوٓا۟","word"],[2,"ﱎ","أَنَّ","word"],[2,"ﱏ","ٱللَّهَ","word"],[2,"ﱐ","مَعَ","word"],[2,"ﱑ","ٱلْمُتَّقِينَ","word"],[3,"ﱒ","١٢٣","end"]]},{"key":"9:124","text":"وَإِذَا مَآ أُنزِلَتْ سُورَةٌ فَمِنْهُم مَّن يَقُولُ أَيُّكُمْ زَادَتْهُ هَـٰذِهِۦٓ إِيمَـٰنًا ۚ فَأَمَّا ٱلَّذِينَ ءَامَنُوا۟ فَزَادَتْهُمْ إِيمَـٰنًا وَهُمْ يَسْتَبْشِرُونَ","words":[[3,"ﱓ","وَإِذَا","word"],[3,"ﱔ","مَآ","word"],[3,"ﱕ","أُنزِلَتْ","word"],[3,"ﱖ","سُورَةٌۭ","word"],[3,"ﱗ","فَمِنْهُم","word"],[3,"ﱘ","مَّن","word"],[3,"ﱙ","يَقُولُ","word"],[3,"ﱚ","أَيُّكُمْ","word"],[3,"ﱛ","زَادَتْهُ","word"],[4,"ﱜ","هَـٰذِهِۦٓ","word"],[4,"ﱝﱞ","إِيمَـٰنًۭا ۚ","word"],[4,"ﱟ","فَأَمَّا","word"],[4,"ﱠ","ٱلَّذِينَ","word"],[4,"ﱡ","ءَامَنُوا۟","word"],[4,"ﱢ","فَزَادَتْهُمْ","word"],[4,"ﱣ","إِيمَـٰنًۭا","word"],[4,"ﱤ","وَهُمْ","word"],[5,"ﱥ","يَسْتَبْشِرُونَ","word"],[5,"ﱦ","١٢٤","end"]]},{"key":"9:125","text":"وَأَمَّا ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ فَزَادَتْهُمْ رِجْسًا إِلَىٰ رِجْسِهِمْ وَمَاتُوا۟ وَهُمْ كَـٰفِرُونَ","words":[[5,"ﱧ","وَأَمَّا","word"],[5,"ﱨ","ٱلَّذِينَ","word"],[5,"ﱩ","فِى","word"],[5,"ﱪ","قُلُوبِهِم","word"],[5,"ﱫ","مَّرَضٌۭ","word"],[5,"ﱬ","فَزَادَتْهُمْ","word"],[6,"ﱭ","رِجْسًا","word"],[6,"ﱮ","إِلَىٰ","word"],[6,"ﱯ","رِجْسِهِمْ","word"],[6,"ﱰ","وَمَاتُوا۟","word"],[6,"ﱱ","وَهُمْ","word"],[6,"ﱲ","كَـٰفِرُونَ","word"],[6,"ﱳ","١٢٥","end"]]},{"key":"9:126","text":"أَوَلَا يَرَوْنَ أَنَّهُمْ يُفْتَنُونَ فِى كُلِّ عَامٍ مَّرَّةً أَوْ مَرَّتَيْنِ ثُم