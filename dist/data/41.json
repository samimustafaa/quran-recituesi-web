{"page":41,"juz":2,"verses":[{"key":"2:249","text":"فَلَمَّا فَصَلَ طَالُوتُ بِٱلْجُنُودِ قَالَ إِنَّ ٱللَّهَ مُبْتَلِيكُم بِنَهَرٍ فَمَن شَرِبَ مِنْهُ فَلَيْسَ مِنِّى وَمَن لَّمْ يَطْعَمْهُ فَإِنَّهُۥ مِنِّىٓ إِلَّا مَنِ ٱغْتَرَفَ غُرْفَةًۢ بِيَدِهِۦ ۚ فَشَرِبُوا۟ مِنْهُ إِلَّا قَلِيلًا مِّنْهُمْ ۚ فَلَمَّا جَاوَزَهُۥ هُوَ وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ قَالُوا۟ لَا طَاقَةَ لَنَا ٱلْيَوْمَ بِجَالُوتَ وَجُنُودِهِۦ ۚ قَالَ ٱلَّذِينَ يَظُنُّونَ أَنَّهُم مُّلَـٰقُوا۟ ٱللَّهِ كَم مِّن فِئَةٍ قَلِيلَةٍ غَلَبَتْ فِئَةً كَثِيرَةًۢ بِإِذْنِ ٱللَّهِ ۗ وَٱللَّهُ مَعَ ٱلصَّـٰبِرِينَ","words":[[1,"ﱁ","فَلَمَّا","word"],[1,"ﱂ","فَصَلَ","word"],[1,"ﱃ","طَالُوتُ","word"],[1,"ﱄ","بِٱلْجُنُودِ","word"],[1,"ﱅ","قَالَ","word"],[1,"ﱆ","إِنَّ","word"],[1,"ﱇ","ٱللَّهَ","word"],[1,"ﱈ","مُبْتَلِيكُم","word"],[2,"ﱉ","بِنَهَرٍۢ","word"],[2,"ﱊ","فَمَن","word"],[2,"ﱋ","شَرِبَ","word"],[2,"ﱌ","مِنْهُ","word"],[2,"ﱍ","فَلَيْسَ","word"],[2,"ﱎ","مِنِّى","word"],[2,"ﱏ","وَمَن","word"],[2,"ﱐ","لَّمْ","word"],[2,"ﱑ","يَطْعَمْهُ","word"],[3,"ﱒ","فَإِنَّهُۥ","word"],[3,"ﱓ","مِنِّىٓ","word"],[3,"ﱔ","إِلَّا","word"],[3,"ﱕ","مَنِ","word"],[3,"ﱖ","ٱغْتَرَفَ","word"],[3,"ﱗ","غُرْفَةًۢ","word"],[3,"ﱘﱙ","بِيَدِهِۦ ۚ","word"],[3,"ﱚ","فَشَرِبُوا۟","word"],[3,"ﱛ","مِنْهُ","word"],[4,"ﱜ","إِلَّا","word"],[4,"ﱝ","قَلِيلًۭا","word"],[4,"ﱞﱟ","مِّنْهُمْ ۚ","word"],[4,"ﱠ","فَلَمَّا","word"],[4,"ﱡ","جَاوَزَهُۥ","word"],[4,"ﱢ","هُوَ","word"],[4,"ﱣ","وَٱلَّذِينَ","word"],[4,"ﱤ","ءَامَنُوا۟","word"],[5,"ﱥ","مَعَهُۥ","word"],[5,"ﱦ","قَالُوا۟","word"],[5,"ﱧ","لَا","word"],[5,"ﱨ","طَاقَةَ","word"],[5,"ﱩ","لَنَا","word"],[5,"ﱪ","ٱلْيَوْمَ","word"],[5,"ﱫ","بِجَالُوتَ","word"],[5,"ﱬﱭ","وَجُنُودِهِۦ ۚ","word"],[6,"ﱮ","قَالَ","word"],[6,"ﱯ","ٱلَّذِينَ","word"],[6,"ﱰ","يَظُنُّونَ","word"],[6,"ﱱ","أَنَّهُم","word"],[6,"ﱲ","مُّلَـٰقُوا۟","word"],[6,"ﱳ","ٱللَّهِ","word"],[6,"ﱴ","كَم","word"],[6,"ﱵ","مِّن","word"],[6,"ﱶ","فِئَةٍۢ","word"],[7,"ﱷ","قَلِيلَةٍ","word"],[7,"ﱸ","غَلَبَتْ","word"],[7,"ﱹ","فِئَةًۭ","word"],[7,"ﱺ","كَثِيرَةًۢ"