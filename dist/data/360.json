{"page":360,"juz":18,"verses":[{"key":"25:3","text":"وَٱتَّخَذُوا۟ مِن دُونِهِۦٓ ءَالِهَةً لَّا يَخْلُقُونَ شَيْـًٔا وَهُمْ يُخْلَقُونَ وَلَا يَمْلِكُونَ لِأَنفُسِهِمْ ضَرًّا وَلَا نَفْعًا وَلَا يَمْلِكُونَ مَوْتًا وَلَا حَيَوٰةً وَلَا نُشُورًا","words":[[1,"ﱁ","وَٱتَّخَذُوا۟","word"],[1,"ﱂ","مِن","word"],[1,"ﱃ","دُونِهِۦٓ","word"],[1,"ﱄ","ءَالِهَةًۭ","word"],[1,"ﱅ","لَّا","word"],[1,"ﱆ","يَخْلُقُونَ","word"],[1,"ﱇ","شَيْـًۭٔا","word"],[1,"ﱈ","وَهُمْ","word"],[1,"ﱉ","يُخْلَقُونَ","word"],[2,"ﱊ","وَلَا","word"],[2,"ﱋ","يَمْلِكُونَ","word"],[2,"ﱌ","لِأَنفُسِهِمْ","word"],[2,"ﱍ","ضَرًّۭا","word"],[2,"ﱎ","وَلَا","word"],[2,"ﱏ","نَفْعًۭا","word"],[2,"ﱐ","وَلَا","word"],[2,"ﱑ","يَمْلِكُونَ","word"],[2,"ﱒ","مَوْتًۭا","word"],[3,"ﱓ","وَلَا","word"],[3,"ﱔ","حَيَوٰةًۭ","word"],[3,"ﱕ","وَلَا","word"],[3,"ﱖ","نُشُورًۭا","word"],[3,"ﱗ","٣","end"]]},{"key":"25:4","text":"وَقَالَ ٱلَّذِينَ كَفَرُوٓا۟ إِنْ هَـٰذَآ إِلَّآ إِفْكٌ ٱفْتَرَىٰهُ وَأَعَانَهُۥ عَلَيْهِ قَوْمٌ ءَاخَرُونَ ۖ فَقَدْ جَآءُو ظُلْمًا وَزُورًا","words":[[3,"ﱘ","وَقَالَ","word"],[3,"ﱙ","ٱلَّذِينَ","word"],[3,"ﱚ","كَفَرُوٓا۟","word"],[3,"ﱛ","إِنْ","word"],[3,"ﱜ","هَـٰذَآ","word"],[3,"ﱝ","إِلَّآ","word"],[4,"ﱞ","إِفْكٌ","word"],[4,"ﱟ","ٱفْتَرَىٰهُ","word"],[4,"ﱠ","وَأَعَانَهُۥ","word"],[4,"ﱡ","عَلَيْهِ","word"],[4,"ﱢ","قَوْمٌ","word"],[4,"ﱣﱤ","ءَاخَرُونَ ۖ","word"],[4,"ﱥ","فَقَدْ","word"],[4,"ﱦ","جَآءُو","word"],[4,"ﱧ","ظُلْمًۭا","word"],[5,"ﱨ","وَزُورًۭا","word"],[5,"ﱩ","٤","end"]]},{"key":"25:5","text":"وَقَالُوٓا۟ أَسَـٰطِيرُ ٱلْأَوَّلِينَ ٱكْتَتَبَهَا فَهِىَ تُمْلَىٰ عَلَيْهِ بُكْرَةً وَأَصِيلًا","words":[[5,"ﱪ","وَقَالُوٓا۟","word"],[5,"ﱫ","أَسَـٰطِيرُ","word"],[5,"ﱬ","ٱلْأَوَّلِينَ","word"],[5,"ﱭ","ٱكْتَتَبَهَا","word"],[5,"ﱮ","فَهِىَ","word"],[5,"ﱯ","تُمْلَىٰ","word"],[6,"ﱰ","عَلَيْهِ","word"],[6,"ﱱ","بُكْرَةًۭ","word"],[6,"ﱲ","وَأَصِيلًۭا","word"],[6,"ﱳ","٥","end"]]},{"key":"25:6","text":"قُلْ أَنزَلَهُ ٱلَّذِى يَعْلَمُ ٱلسِّرَّ فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ إِنَّهُۥ كَانَ غَفُورًا رَّحِيمًا","words"