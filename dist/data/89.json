{"page":89,"juz":5,"verses":[{"key":"4:66","text":"وَلَوْ أَنَّا كَتَبْنَا عَلَيْهِمْ أَنِ ٱقْتُلُوٓا۟ أَنفُسَكُمْ أَوِ ٱخْرُجُوا۟ مِن دِيَـٰرِكُم مَّا فَعَلُوهُ إِلَّا قَلِيلٌ مِّنْهُمْ ۖ وَلَوْ أَنَّهُمْ فَعَلُوا۟ مَا يُوعَظُونَ بِهِۦ لَكَانَ خَيْرًا لَّهُمْ وَأَشَدَّ تَثْبِيتًا","words":[[1,"ﱁ","وَلَوْ","word"],[1,"ﱂ","أَنَّا","word"],[1,"ﱃ","كَتَبْنَا","word"],[1,"ﱄ","عَلَيْهِمْ","word"],[1,"ﱅ","أَنِ","word"],[1,"ﱆ","ٱقْتُلُوٓا۟","word"],[1,"ﱇ","أَنفُسَكُمْ","word"],[1,"ﱈ","أَوِ","word"],[1,"ﱉ","ٱخْرُجُوا۟","word"],[1,"ﱊ","مِن","word"],[2,"ﱋ","دِيَـٰرِكُم","word"],[2,"ﱌ","مَّا","word"],[2,"ﱍ","فَعَلُوهُ","word"],[2,"ﱎ","إِلَّا","word"],[2,"ﱏ","قَلِيلٌۭ","word"],[2,"ﱐﱑ","مِّنْهُمْ ۖ","word"],[2,"ﱒ","وَلَوْ","word"],[2,"ﱓ","أَنَّهُمْ","word"],[2,"ﱔ","فَعَلُوا۟","word"],[2,"ﱕ","مَا","word"],[2,"ﱖ","يُوعَظُونَ","word"],[3,"ﱗ","بِهِۦ","word"],[3,"ﱘ","لَكَانَ","word"],[3,"ﱙ","خَيْرًۭا","word"],[3,"ﱚ","لَّهُمْ","word"],[3,"ﱛ","وَأَشَدَّ","word"],[3,"ﱜ","تَثْبِيتًۭا","word"],[3,"ﱝ","٦٦","end"]]},{"key":"4:67","text":"وَإِذًا لَّـَٔاتَيْنَـٰهُم مِّن لَّدُنَّآ أَجْرًا عَظِيمًا","words":[[3,"ﱞ","وَإِذًۭا","word"],[3,"ﱟ","لَّـَٔاتَيْنَـٰهُم","word"],[4,"ﱠ","مِّن","word"],[4,"ﱡ","لَّدُنَّآ","word"],[4,"ﱢ","أَجْرًا","word"],[4,"ﱣ","عَظِيمًۭا","word"],[4,"ﱤ","٦٧","end"]]},{"key":"4:68","text":"وَلَهَدَيْنَـٰهُمْ صِرَٰطًا مُّسْتَقِيمًا","words":[[4,"ﱥ","وَلَهَدَيْنَـٰهُمْ","word"],[4,"ﱦ","صِرَٰطًۭا","word"],[4,"ﱧ","مُّسْتَقِيمًۭا","word"],[5,"ﱨ","٦٨","end"]]},{"key":"4:69","text":"وَمَن يُطِعِ ٱللَّهَ وَٱلرَّسُولَ فَأُو۟لَـٰٓئِكَ مَعَ ٱلَّذِينَ أَنْعَمَ ٱللَّهُ عَلَيْهِم مِّنَ ٱلنَّبِيِّـۧنَ وَٱلصِّدِّيقِينَ وَٱلشُّهَدَآءِ وَٱلصَّـٰلِحِينَ ۚ وَحَسُنَ أُو۟لَـٰٓئِكَ رَفِيقًا","words":[[5,"ﱩ","وَمَن","word"],[5,"ﱪ","يُطِعِ","word"],[5,"ﱫ","ٱللَّهَ","word"],[5,"ﱬ","وَٱلرَّسُولَ","word"],[5,"ﱭ","فَأُو۟لَـٰٓئِكَ","word"],[5,"ﱮ","مَعَ","word"],[5,"ﱯ","ٱلَّذِينَ","word"],[5,"ﱰ","أَنْعَمَ","word"],[5,"ﱱ","ٱللَّهُ","word"],[6,"ﱲ","عَلَيْهِم","word"],[6,"ﱳ","مِّنَ","word"],[6,"ﱴ","ٱلنّ