{"page":541,"juz":27,"verses":[{"key":"57:25","text":"لَقَدْ أَرْسَلْنَا رُسُلَنَا بِٱلْبَيِّنَـٰتِ وَأَنزَلْنَا مَعَهُمُ ٱلْكِتَـٰبَ وَٱلْمِيزَانَ لِيَقُومَ ٱلنَّاسُ بِٱلْقِسْطِ ۖ وَأَنزَلْنَا ٱلْحَدِيدَ فِيهِ بَأْسٌ شَدِيدٌ وَمَنَـٰفِعُ لِلنَّاسِ وَلِيَعْلَمَ ٱللَّهُ مَن يَنصُرُهُۥ وَرُسُلَهُۥ بِٱلْغَيْبِ ۚ إِنَّ ٱللَّهَ قَوِىٌّ عَزِيزٌ","words":[[1,"ﱁ","لَقَدْ","word"],[1,"ﱂ","أَرْسَلْنَا","word"],[1,"ﱃ","رُسُلَنَا","word"],[1,"ﱄ","بِٱلْبَيِّنَـٰتِ","word"],[1,"ﱅ","وَأَنزَلْنَا","word"],[1,"ﱆ","مَعَهُمُ","word"],[1,"ﱇ","ٱلْكِتَـٰبَ","word"],[2,"ﱈ","وَٱلْمِيزَانَ","word"],[2,"ﱉ","لِيَقُومَ","word"],[2,"ﱊ","ٱلنَّاسُ","word"],[2,"ﱋﱌ","بِٱلْقِسْطِ ۖ","word"],[2,"ﱍ","وَأَنزَلْنَا","word"],[2,"ﱎ","ٱلْحَدِيدَ","word"],[2,"ﱏ","فِيهِ","word"],[3,"ﱐ","بَأْسٌۭ","word"],[3,"ﱑ","شَدِيدٌۭ","word"],[3,"ﱒ","وَمَنَـٰفِعُ","word"],[3,"ﱓ","لِلنَّاسِ","word"],[3,"ﱔ","وَلِيَعْلَمَ","word"],[3,"ﱕ","ٱللَّهُ","word"],[3,"ﱖ","مَن","word"],[3,"ﱗ","يَنصُرُهُۥ","word"],[3,"ﱘ","وَرُسُلَهُۥ","word"],[4,"ﱙﱚ","بِٱلْغَيْبِ ۚ","word"],[4,"ﱛ","إِنَّ","word"],[4,"ﱜ","ٱللَّهَ","word"],[4,"ﱝ","قَوِىٌّ","word"],[4,"ﱞ","عَزِيزٌۭ","word"],[4,"ﱟ","٢٥","end"]]},{"key":"57:26","text":"وَلَقَدْ أَرْسَلْنَا نُوحًا وَإِبْرَٰهِيمَ وَجَعَلْنَا فِى ذُرِّيَّتِهِمَا ٱلنُّبُوَّةَ وَٱلْكِتَـٰبَ ۖ فَمِنْهُم مُّهْتَدٍ ۖ وَكَثِيرٌ مِّنْهُمْ فَـٰسِقُونَ","words":[[4,"ﱠ","وَلَقَدْ","word"],[4,"ﱡ","أَرْسَلْنَا","word"],[4,"ﱢ","نُوحًۭا","word"],[4,"ﱣ","وَإِبْرَٰهِيمَ","word"],[5,"ﱤ","وَجَعَلْنَا","word"],[5,"ﱥ","فِى","word"],[5,"ﱦ","ذُرِّيَّتِهِمَا","word"],[5,"ﱧ","ٱلنُّبُوَّةَ","word"],[5,"ﱨﱩ","وَٱلْكِتَـٰبَ ۖ","word"],[5,"ﱪ","فَمِنْهُم","word"],[5,"ﱫﱬ","مُّهْتَدٍۢ ۖ","word"],[6,"ﱭ","وَكَثِيرٌۭ","word"],[6,"ﱮ","مِّنْهُمْ","word"],[6,"ﱯ","فَـٰسِقُونَ","word"],[6,"ﱰ","٢٦","end"]]},{"key":"57:27","text":"ثُمَّ قَفَّيْنَا عَلَىٰٓ ءَاثَـٰرِهِم بِرُسُلِنَا وَقَفَّيْنَا بِعِيسَى ٱبْنِ مَرْيَمَ وَءَاتَيْنَـٰهُ ٱلْإِنجِيلَ وَجَعَلْنَا فِى قُلُوبِ ٱلَّذِينَ ٱتَّبَعُوهُ رَأْفَةً وَرَحْمَةً وَرَهْبَانِيَّةً ٱبْتَدَعُوهَا مَا كَتَبْنَ