{"page":511,"juz":26,"verses":[{"key":"48:1","text":" إِنَّا فَتَحْنَا لَكَ فَتْحًا مُّبِينًا","words":[[3,"ﱁ","إِنَّا","word"],[3,"ﱂ","فَتَحْنَا","word"],[3,"ﱃ","لَكَ","word"],[3,"ﱄ","فَتْحًۭا","word"],[3,"ﱅ","مُّبِينًۭا","word"],[3,"ﱆ","١","end"]]},{"key":"48:2","text":"لِّيَغْفِرَ لَكَ ٱللَّهُ مَا تَقَدَّمَ مِن ذَنۢبِكَ وَمَا تَأَخَّرَ وَيُتِمَّ نِعْمَتَهُۥ عَلَيْكَ وَيَهْدِيَكَ صِرَٰطًا مُّسْتَقِيمًا","words":[[3,"ﱇ","لِّيَغْفِرَ","word"],[3,"ﱈ","لَكَ","word"],[3,"ﱉ","ٱللَّهُ","word"],[3,"ﱊ","مَا","word"],[3,"ﱋ","تَقَدَّمَ","word"],[3,"ﱌ","مِن","word"],[3,"ﱍ","ذَنۢبِكَ","word"],[4,"ﱎ","وَمَا","word"],[4,"ﱏ","تَأَخَّرَ","word"],[4,"ﱐ","وَيُتِمَّ","word"],[4,"ﱑ","نِعْمَتَهُۥ","word"],[4,"ﱒ","عَلَيْكَ","word"],[4,"ﱓ","وَيَهْدِيَكَ","word"],[4,"ﱔ","صِرَٰطًۭا","word"],[4,"ﱕ","مُّسْتَقِيمًۭا","word"],[4,"ﱖ","٢","end"]]},{"key":"48:3","text":"وَيَنصُرَكَ ٱللَّهُ نَصْرًا عَزِيزًا","words":[[5,"ﱗ","وَيَنصُرَكَ","word"],[5,"ﱘ","ٱللَّهُ","word"],[5,"ﱙ","نَصْرًا","word"],[5,"ﱚ","عَزِيزًا","word"],[5,"ﱛ","٣","end"]]},{"key":"48:4","text":"هُوَ ٱلَّذِىٓ أَنزَلَ ٱلسَّكِينَةَ فِى قُلُوبِ ٱلْمُؤْمِنِينَ لِيَزْدَادُوٓا۟ إِيمَـٰنًا مَّعَ إِيمَـٰنِهِمْ ۗ وَلِلَّهِ جُنُودُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا","words":[[5,"ﱜ","هُوَ","word"],[5,"ﱝ","ٱلَّذِىٓ","word"],[5,"ﱞ","أَنزَلَ","word"],[5,"ﱟ","ٱلسَّكِينَةَ","word"],[5,"ﱠ","فِى","word"],[5,"ﱡ","قُلُوبِ","word"],[6,"ﱢ","ٱلْمُؤْمِنِينَ","word"],[6,"ﱣ","لِيَزْدَادُوٓا۟","word"],[6,"ﱤ","إِيمَـٰنًۭا","word"],[6,"ﱥ","مَّعَ","word"],[6,"ﱦﱧ","إِيمَـٰنِهِمْ ۗ","word"],[6,"ﱨ","وَلِلَّهِ","word"],[6,"ﱩ","جُنُودُ","word"],[6,"ﱪ","ٱلسَّمَـٰوَٰتِ","word"],[7,"ﱫﱬ","وَٱلْأَرْضِ ۚ","word"],[7,"ﱭ","وَكَانَ","word"],[7,"ﱮ","ٱللَّهُ","word"],[7,"ﱯ","عَلِيمًا","word"],[7,"ﱰ","حَكِيمًۭا","word"],[7,"ﱱ","٤","end"]]},{"key":"48:5","text":"لِّيُدْخِلَ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ جَنَّـٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا وَيُكَفِّرَ عَنْهُمْ سَيِّـَٔاتِهِمْ ۚ وَكَانَ ذَٰلِكَ عِندَ ٱللَّهِ فَوْزًا عَظِ