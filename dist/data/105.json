{"page":105,"juz":6,"verses":[{"key":"4:171","text":"يَـٰٓأَهْلَ ٱلْكِتَـٰبِ لَا تَغْلُوا۟ فِى دِينِكُمْ وَلَا تَقُولُوا۟ عَلَى ٱللَّهِ إِلَّا ٱلْحَقَّ ۚ إِنَّمَا ٱلْمَسِيحُ عِيسَى ٱبْنُ مَرْيَمَ رَسُولُ ٱللَّهِ وَكَلِمَتُهُۥٓ أَلْقَىٰهَآ إِلَىٰ مَرْيَمَ وَرُوحٌ مِّنْهُ ۖ فَـَٔامِنُوا۟ بِٱللَّهِ وَرُسُلِهِۦ ۖ وَلَا تَقُولُوا۟ ثَلَـٰثَةٌ ۚ ٱنتَهُوا۟ خَيْرًا لَّكُمْ ۚ إِنَّمَا ٱللَّهُ إِلَـٰهٌ وَٰحِدٌ ۖ سُبْحَـٰنَهُۥٓ أَن يَكُونَ لَهُۥ وَلَدٌ ۘ لَّهُۥ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۗ وَكَفَىٰ بِٱللَّهِ وَكِيلًا","words":[[1,"ﱁ","يَـٰٓأَهْلَ","word"],[1,"ﱂ","ٱلْكِتَـٰبِ","word"],[1,"ﱃ","لَا","word"],[1,"ﱄ","تَغْلُوا۟","word"],[1,"ﱅ","فِى","word"],[1,"ﱆ","دِينِكُمْ","word"],[1,"ﱇ","وَلَا","word"],[1,"ﱈ","تَقُولُوا۟","word"],[1,"ﱉ","عَلَى","word"],[2,"ﱊ","ٱللَّهِ","word"],[2,"ﱋ","إِلَّا","word"],[2,"ﱌﱍ","ٱلْحَقَّ ۚ","word"],[2,"ﱎ","إِنَّمَا","word"],[2,"ﱏ","ٱلْمَسِيحُ","word"],[2,"ﱐ","عِيسَى","word"],[2,"ﱑ","ٱبْنُ","word"],[2,"ﱒ","مَرْيَمَ","word"],[2,"ﱓ","رَسُولُ","word"],[2,"ﱔ","ٱللَّهِ","word"],[3,"ﱕ","وَكَلِمَتُهُۥٓ","word"],[3,"ﱖ","أَلْقَىٰهَآ","word"],[3,"ﱗ","إِلَىٰ","word"],[3,"ﱘ","مَرْيَمَ","word"],[3,"ﱙ","وَرُوحٌۭ","word"],[3,"ﱚﱛ","مِّنْهُ ۖ","word"],[3,"ﱜ","فَـَٔامِنُوا۟","word"],[3,"ﱝ","بِٱللَّهِ","word"],[4,"ﱞﱟ","وَرُسُلِهِۦ ۖ","word"],[4,"ﱠ","وَلَا","word"],[4,"ﱡ","تَقُولُوا۟","word"],[4,"ﱢﱣ","ثَلَـٰثَةٌ ۚ","word"],[4,"ﱤ","ٱنتَهُوا۟","word"],[4,"ﱥ","خَيْرًۭا","word"],[4,"ﱦﱧ","لَّكُمْ ۚ","word"],[4,"ﱨ","إِنَّمَا","word"],[4,"ﱩ","ٱللَّهُ","word"],[5,"ﱪ","إِلَـٰهٌۭ","word"],[5,"ﱫﱬ","وَٰحِدٌۭ ۖ","word"],[5,"ﱭ","سُبْحَـٰنَهُۥٓ","word"],[5,"ﱮ","أَن","word"],[5,"ﱯ","يَكُونَ","word"],[5,"ﱰ","لَهُۥ","word"],[5,"ﱱﱲ","وَلَدٌۭ ۘ","word"],[5,"ﱳ","لَّهُۥ","word"],[5,"ﱴ","مَا","word"],[5,"ﱵ","فِى","word"],[5,"ﱶ","ٱلسَّمَـٰوَٰتِ","word"],[6,"ﱷ","وَمَا","word"],[6,"ﱸ","فِى","word"],[6,"ﱹﱺ","ٱلْأَرْضِ ۗ","word"],[6,"ﱻ","وَكَفَىٰ","word"],[6,"ﱼ","بِٱللَّهِ","word"],[6,"ﱽ","وَكِيلًۭا","word"],[6,"ﱾ","١٧١","end"]]},{"key":"4:172","text":"لَّن يَسْتَنكِفَ ٱلْمَسِيحُ