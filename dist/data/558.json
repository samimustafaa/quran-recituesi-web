{"page":558,"juz":28,"verses":[{"key":"65:1","text":" يَـٰٓأَيُّهَا ٱلنَّبِىُّ إِذَا طَلَّقْتُمُ ٱلنِّسَآءَ فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ وَأَحْصُوا۟ ٱلْعِدَّةَ ۖ وَٱتَّقُوا۟ ٱللَّهَ رَبَّكُمْ ۖ لَا تُخْرِجُوهُنَّ مِنۢ بُيُوتِهِنَّ وَلَا يَخْرُجْنَ إِلَّآ أَن يَأْتِينَ بِفَـٰحِشَةٍ مُّبَيِّنَةٍ ۚ وَتِلْكَ حُدُودُ ٱللَّهِ ۚ وَمَن يَتَعَدَّ حُدُودَ ٱللَّهِ فَقَدْ ظَلَمَ نَفْسَهُۥ ۚ لَا تَدْرِى لَعَلَّ ٱللَّهَ يُحْدِثُ بَعْدَ ذَٰلِكَ أَمْرًا","words":[[2,"ﱁ","يَـٰٓأَيُّهَا","word"],[2,"ﱂ","ٱلنَّبِىُّ","word"],[2,"ﱃ","إِذَا","word"],[2,"ﱄ","طَلَّقْتُمُ","word"],[2,"ﱅ","ٱلنِّسَآءَ","word"],[2,"ﱆ","فَطَلِّقُوهُنَّ","word"],[2,"ﱇ","لِعِدَّتِهِنَّ","word"],[2,"ﱈ","وَأَحْصُوا۟","word"],[2,"ﱉﱊ","ٱلْعِدَّةَ ۖ","word"],[3,"ﱋ","وَٱتَّقُوا۟","word"],[3,"ﱌ","ٱللَّهَ","word"],[3,"ﱍﱎ","رَبَّكُمْ ۖ","word"],[3,"ﱏ","لَا","word"],[3,"ﱐ","تُخْرِجُوهُنَّ","word"],[3,"ﱑ","مِنۢ","word"],[3,"ﱒ","بُيُوتِهِنَّ","word"],[3,"ﱓ","وَلَا","word"],[3,"ﱔ","يَخْرُجْنَ","word"],[3,"ﱕ","إِلَّآ","word"],[3,"ﱖ","أَن","word"],[4,"ﱗ","يَأْتِينَ","word"],[4,"ﱘ","بِفَـٰحِشَةٍۢ","word"],[4,"ﱙﱚ","مُّبَيِّنَةٍۢ ۚ","word"],[4,"ﱛ","وَتِلْكَ","word"],[4,"ﱜ","حُدُودُ","word"],[4,"ﱝﱞ","ٱللَّهِ ۚ","word"],[4,"ﱟ","وَمَن","word"],[4,"ﱠ","يَتَعَدَّ","word"],[4,"ﱡ","حُدُودَ","word"],[4,"ﱢ","ٱللَّهِ","word"],[5,"ﱣ","فَقَدْ","word"],[5,"ﱤ","ظَلَمَ","word"],[5,"ﱥﱦ","نَفْسَهُۥ ۚ","word"],[5,"ﱧ","لَا","word"],[5,"ﱨ","تَدْرِى","word"],[5,"ﱩ","لَعَلَّ","word"],[5,"ﱪ","ٱللَّهَ","word"],[5,"ﱫ","يُحْدِثُ","word"],[5,"ﱬ","بَعْدَ","word"],[5,"ﱭ","ذَٰلِكَ","word"],[5,"ﱮ","أَمْرًۭا","word"],[5,"ﱯ","١","end"]]},{"key":"65:2","text":"فَإِذَا بَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ فَارِقُوهُنَّ بِمَعْرُوفٍ وَأَشْهِدُوا۟ ذَوَىْ عَدْلٍ مِّنكُمْ وَأَقِيمُوا۟ ٱلشَّهَـٰدَةَ لِلَّهِ ۚ ذَٰلِكُمْ يُوعَظُ بِهِۦ مَن كَانَ يُؤْمِنُ بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۚ وَمَن يَتَّقِ ٱللَّهَ يَجْعَل لَّهُۥ مَخْرَجًا","words":[[6,"ﱰ","فَإِذَا","word"],[6,"ﱱ","بَلَغْنَ","word"],[6,"ﱲ","أَجَلَهُنَّ","word"],[6,"ﱳ","فَأَمْسِكُوهُنَّ",