{"page":559,"juz":28,"verses":[{"key":"65:6","text":"أَسْكِنُوهُنَّ مِنْ حَيْثُ سَكَنتُم مِّن وُجْدِكُمْ وَلَا تُضَآرُّوهُنَّ لِتُضَيِّقُوا۟ عَلَيْهِنَّ ۚ وَإِن كُنَّ أُو۟لَـٰتِ حَمْلٍ فَأَنفِقُوا۟ عَلَيْهِنَّ حَتَّىٰ يَضَعْنَ حَمْلَهُنَّ ۚ فَإِنْ أَرْضَعْنَ لَكُمْ فَـَٔاتُوهُنَّ أُجُورَهُنَّ ۖ وَأْتَمِرُوا۟ بَيْنَكُم بِمَعْرُوفٍ ۖ وَإِن تَعَاسَرْتُمْ فَسَتُرْضِعُ لَهُۥٓ أُخْرَىٰ","words":[[1,"ﱁ","أَسْكِنُوهُنَّ","word"],[1,"ﱂ","مِنْ","word"],[1,"ﱃ","حَيْثُ","word"],[1,"ﱄ","سَكَنتُم","word"],[1,"ﱅ","مِّن","word"],[1,"ﱆ","وُجْدِكُمْ","word"],[1,"ﱇ","وَلَا","word"],[1,"ﱈ","تُضَآرُّوهُنَّ","word"],[1,"ﱉ","لِتُضَيِّقُوا۟","word"],[2,"ﱊﱋ","عَلَيْهِنَّ ۚ","word"],[2,"ﱌ","وَإِن","word"],[2,"ﱍ","كُنَّ","word"],[2,"ﱎ","أُو۟لَـٰتِ","word"],[2,"ﱏ","حَمْلٍۢ","word"],[2,"ﱐ","فَأَنفِقُوا۟","word"],[2,"ﱑ","عَلَيْهِنَّ","word"],[2,"ﱒ","حَتَّىٰ","word"],[2,"ﱓ","يَضَعْنَ","word"],[2,"ﱔﱕ","حَمْلَهُنَّ ۚ","word"],[2,"ﱖ","فَإِنْ","word"],[3,"ﱗ","أَرْضَعْنَ","word"],[3,"ﱘ","لَكُمْ","word"],[3,"ﱙ","فَـَٔاتُوهُنَّ","word"],[3,"ﱚ","أُجُورَهُنَّ ۖ","word"],[3,"ﱛ","وَأْتَمِرُوا۟","word"],[3,"ﱜ","بَيْنَكُم","word"],[3,"ﱝﱞ","بِمَعْرُوفٍۢ ۖ","word"],[3,"ﱟ","وَإِن","word"],[4,"ﱠ","تَعَاسَرْتُمْ","word"],[4,"ﱡ","فَسَتُرْضِعُ","word"],[4,"ﱢ","لَهُۥٓ","word"],[4,"ﱣ","أُخْرَىٰ","word"],[4,"ﱤ","٦","end"]]},{"key":"65:7","text":"لِيُنفِقْ ذُو سَعَةٍ مِّن سَعَتِهِۦ ۖ وَمَن قُدِرَ عَلَيْهِ رِزْقُهُۥ فَلْيُنفِقْ مِمَّآ ءَاتَىٰهُ ٱللَّهُ ۚ لَا يُكَلِّفُ ٱللَّهُ نَفْسًا إِلَّا مَآ ءَاتَىٰهَا ۚ سَيَجْعَلُ ٱللَّهُ بَعْدَ عُسْرٍ يُسْرًا","words":[[4,"ﱥ","لِيُنفِقْ","word"],[4,"ﱦ","ذُو","word"],[4,"ﱧ","سَعَةٍۢ","word"],[4,"ﱨ","مِّن","word"],[4,"ﱩﱪ","سَعَتِهِۦ ۖ","word"],[4,"ﱫ","وَمَن","word"],[5,"ﱬ","قُدِرَ","word"],[5,"ﱭ","عَلَيْهِ","word"],[5,"ﱮ","رِزْقُهُۥ","word"],[5,"ﱯ","فَلْيُنفِقْ","word"],[5,"ﱰ","مِمَّآ","word"],[5,"ﱱ","ءَاتَىٰهُ","word"],[5,"ﱲﱳ","ٱللَّهُ ۚ","word"],[5,"ﱴ","لَا","word"],[5,"ﱵ","يُكَلِّفُ","word"],[5,"ﱶ","ٱللَّهُ","word"],[5,"ﱷ","نَفْسًا","word"],[5,"ﱸ","إِلَّا","word"],[6,"ﱹ","مَآ