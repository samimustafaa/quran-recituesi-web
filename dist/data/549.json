{"page":549,"juz":28,"verses":[{"key":"60:1","text":" يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَتَّخِذُوا۟ عَدُوِّى وَعَدُوَّكُمْ أَوْلِيَآءَ تُلْقُونَ إِلَيْهِم بِٱلْمَوَدَّةِ وَقَدْ كَفَرُوا۟ بِمَا جَآءَكُم مِّنَ ٱلْحَقِّ يُخْرِجُونَ ٱلرَّسُولَ وَإِيَّاكُمْ ۙ أَن تُؤْمِنُوا۟ بِٱللَّهِ رَبِّكُمْ إِن كُنتُمْ خَرَجْتُمْ جِهَـٰدًا فِى سَبِيلِى وَٱبْتِغَآءَ مَرْضَاتِى ۚ تُسِرُّونَ إِلَيْهِم بِٱلْمَوَدَّةِ وَأَنَا۠ أَعْلَمُ بِمَآ أَخْفَيْتُمْ وَمَآ أَعْلَنتُمْ ۚ وَمَن يَفْعَلْهُ مِنكُمْ فَقَدْ ضَلَّ سَوَآءَ ٱلسَّبِيلِ","words":[[2,"ﱁ","يَـٰٓأَيُّهَا","word"],[2,"ﱂ","ٱلَّذِينَ","word"],[2,"ﱃ","ءَامَنُوا۟","word"],[2,"ﱄ","لَا","word"],[2,"ﱅ","تَتَّخِذُوا۟","word"],[2,"ﱆ","عَدُوِّى","word"],[2,"ﱇ","وَعَدُوَّكُمْ","word"],[2,"ﱈ","أَوْلِيَآءَ","word"],[2,"ﱉ","تُلْقُونَ","word"],[3,"ﱊ","إِلَيْهِم","word"],[3,"ﱋ","بِٱلْمَوَدَّةِ","word"],[3,"ﱌ","وَقَدْ","word"],[3,"ﱍ","كَفَرُوا۟","word"],[3,"ﱎ","بِمَا","word"],[3,"ﱏ","جَآءَكُم","word"],[3,"ﱐ","مِّنَ","word"],[3,"ﱑ","ٱلْحَقِّ","word"],[3,"ﱒ","يُخْرِجُونَ","word"],[3,"ﱓ","ٱلرَّسُولَ","word"],[4,"ﱔ","وَإِيَّاكُمْ ۙ","word"],[4,"ﱕ","أَن","word"],[4,"ﱖ","تُؤْمِنُوا۟","word"],[4,"ﱗ","بِٱللَّهِ","word"],[4,"ﱘ","رَبِّكُمْ","word"],[4,"ﱙ","إِن","word"],[4,"ﱚ","كُنتُمْ","word"],[4,"ﱛ","خَرَجْتُمْ","word"],[4,"ﱜ","جِهَـٰدًۭا","word"],[4,"ﱝ","فِى","word"],[4,"ﱞ","سَبِيلِى","word"],[5,"ﱟ","وَٱبْتِغَآءَ","word"],[5,"ﱠﱡ","مَرْضَاتِى ۚ","word"],[5,"ﱢ","تُسِرُّونَ","word"],[5,"ﱣ","إِلَيْهِم","word"],[5,"ﱤ","بِٱلْمَوَدَّةِ","word"],[5,"ﱥ","وَأَنَا۠","word"],[5,"ﱦ","أَعْلَمُ","word"],[5,"ﱧ","بِمَآ","word"],[5,"ﱨ","أَخْفَيْتُمْ","word"],[6,"ﱩ","وَمَآ","word"],[6,"ﱪﱫ","أَعْلَنتُمْ ۚ","word"],[6,"ﱬ","وَمَن","word"],[6,"ﱭ","يَفْعَلْهُ","word"],[6,"ﱮ","مِنكُمْ","word"],[6,"ﱯ","فَقَدْ","word"],[6,"ﱰ","ضَلَّ","word"],[6,"ﱱ","سَوَآءَ","word"],[6,"ﱲ","ٱلسَّبِيلِ","word"],[6,"ﱳ","١","end"]]},{"key":"60:2","text":"إِن يَثْقَفُوكُمْ يَكُونُوا۟ لَكُمْ أَعْدَآءً وَيَبْسُطُوٓا۟ إِلَيْكُمْ أَيْدِيَهُمْ وَأَلْسِنَتَهُم بِٱلسُّوٓءِ وَوَدُّوا۟ لَوْ تَك