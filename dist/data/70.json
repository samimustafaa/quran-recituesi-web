{"page":70,"juz":4,"verses":[{"key":"3:154","text":"ثُمَّ أَنزَلَ عَلَيْكُم مِّنۢ بَعْدِ ٱلْغَمِّ أَمَنَةً نُّعَاسًا يَغْشَىٰ طَآئِفَةً مِّنكُمْ ۖ وَطَآئِفَةٌ قَدْ أَهَمَّتْهُمْ أَنفُسُهُمْ يَظُنُّونَ بِٱللَّهِ غَيْرَ ٱلْحَقِّ ظَنَّ ٱلْجَـٰهِلِيَّةِ ۖ يَقُولُونَ هَل لَّنَا مِنَ ٱلْأَمْرِ مِن شَىْءٍ ۗ قُلْ إِنَّ ٱلْأَمْرَ كُلَّهُۥ لِلَّهِ ۗ يُخْفُونَ فِىٓ أَنفُسِهِم مَّا لَا يُبْدُونَ لَكَ ۖ يَقُولُونَ لَوْ كَانَ لَنَا مِنَ ٱلْأَمْرِ شَىْءٌ مَّا قُتِلْنَا هَـٰهُنَا ۗ قُل لَّوْ كُنتُمْ فِى بُيُوتِكُمْ لَبَرَزَ ٱلَّذِينَ كُتِبَ عَلَيْهِمُ ٱلْقَتْلُ إِلَىٰ مَضَاجِعِهِمْ ۖ وَلِيَبْتَلِىَ ٱللَّهُ مَا فِى صُدُورِكُمْ وَلِيُمَحِّصَ مَا فِى قُلُوبِكُمْ ۗ وَٱللَّهُ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ","words":[[1,"ﱁ","ثُمَّ","word"],[1,"ﱂ","أَنزَلَ","word"],[1,"ﱃ","عَلَيْكُم","word"],[1,"ﱄ","مِّنۢ","word"],[1,"ﱅ","بَعْدِ","word"],[1,"ﱆ","ٱلْغَمِّ","word"],[1,"ﱇ","أَمَنَةًۭ","word"],[1,"ﱈ","نُّعَاسًۭا","word"],[1,"ﱉ","يَغْشَىٰ","word"],[1,"ﱊ","طَآئِفَةًۭ","word"],[2,"ﱋﱌ","مِّنكُمْ ۖ","word"],[2,"ﱍ","وَطَآئِفَةٌۭ","word"],[2,"ﱎ","قَدْ","word"],[2,"ﱏ","أَهَمَّتْهُمْ","word"],[2,"ﱐ","أَنفُسُهُمْ","word"],[2,"ﱑ","يَظُنُّونَ","word"],[2,"ﱒ","بِٱللَّهِ","word"],[2,"ﱓ","غَيْرَ","word"],[3,"ﱔ","ٱلْحَقِّ","word"],[3,"ﱕ","ظَنَّ","word"],[3,"ﱖﱗ","ٱلْجَـٰهِلِيَّةِ ۖ","word"],[3,"ﱘ","يَقُولُونَ","word"],[3,"ﱙ","هَل","word"],[3,"ﱚ","لَّنَا","word"],[3,"ﱛ","مِنَ","word"],[3,"ﱜ","ٱلْأَمْرِ","word"],[3,"ﱝ","مِن","word"],[3,"ﱞﱟ","شَىْءٍۢ ۗ","word"],[4,"ﱠ","قُلْ","word"],[4,"ﱡ","إِنَّ","word"],[4,"ﱢ","ٱلْأَمْرَ","word"],[4,"ﱣ","كُلَّهُۥ","word"],[4,"ﱤﱥ","لِلَّهِ ۗ","word"],[4,"ﱦ","يُخْفُونَ","word"],[4,"ﱧ","فِىٓ","word"],[4,"ﱨ","أَنفُسِهِم","word"],[4,"ﱩ","مَّا","word"],[4,"ﱪ","لَا","word"],[4,"ﱫ","يُبْدُونَ","word"],[4,"ﱬﱭ","لَكَ ۖ","word"],[5,"ﱮ","يَقُولُونَ","word"],[5,"ﱯ","لَوْ","word"],[5,"ﱰ","كَانَ","word"],[5,"ﱱ","لَنَا","word"],[5,"ﱲ","مِنَ","word"],[5,"ﱳ","ٱلْأَمْرِ","word"],[5,"ﱴ","شَىْءٌۭ","word"],[5,"ﱵ","مَّا","word"],[5,"ﱶ","قُتِلْنَا","word"],[5,"ﱷﱸ","هَـٰهُنَا ۗ","word"],[5,"ﱹ","قُل",