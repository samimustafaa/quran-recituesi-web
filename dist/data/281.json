{"page":281,"juz":14,"verses":[{"key":"16:119","text":"ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ عَمِلُوا۟ ٱلسُّوٓءَ بِجَهَـٰلَةٍ ثُمَّ تَابُوا۟ مِنۢ بَعْدِ ذَٰلِكَ وَأَصْلَحُوٓا۟ إِنَّ رَبَّكَ مِنۢ بَعْدِهَا لَغَفُورٌ رَّحِيمٌ","words":[[1,"ﱁ","ثُمَّ","word"],[1,"ﱂ","إِنَّ","word"],[1,"ﱃ","رَبَّكَ","word"],[1,"ﱄ","لِلَّذِينَ","word"],[1,"ﱅ","عَمِلُوا۟","word"],[1,"ﱆ","ٱلسُّوٓءَ","word"],[1,"ﱇ","بِجَهَـٰلَةٍۢ","word"],[1,"ﱈ","ثُمَّ","word"],[1,"ﱉ","تَابُوا۟","word"],[1,"ﱊ","مِنۢ","word"],[1,"ﱋ","بَعْدِ","word"],[2,"ﱌ","ذَٰلِكَ","word"],[2,"ﱍ","وَأَصْلَحُوٓا۟","word"],[2,"ﱎ","إِنَّ","word"],[2,"ﱏ","رَبَّكَ","word"],[2,"ﱐ","مِنۢ","word"],[2,"ﱑ","بَعْدِهَا","word"],[2,"ﱒ","لَغَفُورٌۭ","word"],[2,"ﱓ","رَّحِيمٌ","word"],[2,"ﱔ","١١٩","end"]]},{"key":"16:120","text":"إِنَّ إِبْرَٰهِيمَ كَانَ أُمَّةً قَانِتًا لِّلَّهِ حَنِيفًا وَلَمْ يَكُ مِنَ ٱلْمُشْرِكِينَ","words":[[2,"ﱕ","إِنَّ","word"],[3,"ﱖ","إِبْرَٰهِيمَ","word"],[3,"ﱗ","كَانَ","word"],[3,"ﱘ","أُمَّةًۭ","word"],[3,"ﱙ","قَانِتًۭا","word"],[3,"ﱚ","لِّلَّهِ","word"],[3,"ﱛ","حَنِيفًۭا","word"],[3,"ﱜ","وَلَمْ","word"],[3,"ﱝ","يَكُ","word"],[3,"ﱞ","مِنَ","word"],[3,"ﱟ","ٱلْمُشْرِكِينَ","word"],[4,"ﱠ","١٢٠","end"]]},{"key":"16:121","text":"شَاكِرًا لِّأَنْعُمِهِ ۚ ٱجْتَبَىٰهُ وَهَدَىٰهُ إِلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ","words":[[4,"ﱡ","شَاكِرًۭا","word"],[4,"ﱢﱣ","لِّأَنْعُمِهِ ۚ","word"],[4,"ﱤ","ٱجْتَبَىٰهُ","word"],[4,"ﱥ","وَهَدَىٰهُ","word"],[4,"ﱦ","إِلَىٰ","word"],[4,"ﱧ","صِرَٰطٍۢ","word"],[4,"ﱨ","مُّسْتَقِيمٍۢ","word"],[5,"ﱩ","١٢١","end"]]},{"key":"16:122","text":"وَءَاتَيْنَـٰهُ فِى ٱلدُّنْيَا حَسَنَةً ۖ وَإِنَّهُۥ فِى ٱلْـَٔاخِرَةِ لَمِنَ ٱلصَّـٰلِحِينَ","words":[[5,"ﱪ","وَءَاتَيْنَـٰهُ","word"],[5,"ﱫ","فِى","word"],[5,"ﱬ","ٱلدُّنْيَا","word"],[5,"ﱭﱮ","حَسَنَةًۭ ۖ","word"],[5,"ﱯ","وَإِنَّهُۥ","word"],[5,"ﱰ","فِى","word"],[5,"ﱱ","ٱلْـَٔاخِرَةِ","word"],[5,"ﱲ","لَمِنَ","word"],[5,"ﱳ","ٱلصَّـٰلِحِينَ","word"],[6,"ﱴ","١٢٢","end"]]},{"key":"16:123","text":"ثُمَّ أَوْحَيْنَآ إِلَيْكَ أَنِ ٱتَّبِعْ مِلَّةَ إِبْرَٰهِيمَ حَنِيفًا ۖ وَمَا كَ