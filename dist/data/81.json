نَكُمْ وَأَخَوَٰتُكُم مِّنَ ٱلرَّضَـٰعَةِ وَأُمَّهَـٰتُ نِسَآئِكُمْ وَرَبَـٰٓئِبُكُمُ ٱلَّـٰتِى فِى حُجُورِكُم مِّن نِّسَآئِكُمُ ٱلَّـٰتِى دَخَلْتُم بِهِنَّ فَإِن لَّمْ تَكُونُوا۟ دَخَلْتُم بِهِنَّ فَلَا جُنَاحَ عَلَيْكُمْ وَحَلَـٰٓئِلُ أَبْنَآئِكُمُ ٱلَّذِينَ مِنْ أَصْلَـٰبِكُمْ وَأَن تَجْمَعُوا۟ بَيْنَ ٱلْأُخْتَيْنِ إِلَّا مَا قَدْ سَلَفَ ۗ إِنَّ ٱللَّهَ كَانَ غَفُورًا رَّحِيمًا","words":[[7,"ﱳ","حُرِّمَتْ","word"],[7,"ﱴ","عَلَيْكُمْ","word"],[7,"ﱵ","أُمَّهَـٰتُكُمْ","word"],[7,"ﱶ","وَبَنَاتُكُمْ","word"],[8,"ﱷ","وَأَخَوَٰتُكُمْ","word"],[8,"ﱸ","وَعَمَّـٰتُكُمْ","word"],[8,"ﱹ","وَخَـٰلَـٰتُكُمْ","word"],[8,"ﱺ","وَبَنَاتُ","word"],[9,"ﱻ","ٱلْأَخِ","word"],[9,"ﱼ","وَبَنَاتُ","word"],[9,"ﱽ","ٱلْأُخْتِ","word"],[9,"ﱾ","وَأُمَّهَـٰتُكُمُ","word"],[9,"ﱿ","ٱلَّـٰتِىٓ","word"],[9,"ﲀ","أَرْضَعْنَكُمْ","word"],[10,"ﲁ","وَأَخَوَٰتُكُم","word"],[10,"ﲂ","مِّنَ","word"],[10,"ﲃ","ٱلرَّضَـٰعَةِ","word"],[10,"ﲄ","وَأُمَّهَـٰتُ","word"],[10,"ﲅ","نِسَآئِكُمْ","word"],[11,"ﲆ","وَرَبَـٰٓئِبُكُمُ","word"],[11,"ﲇ","ٱلَّـٰتِى","word"],[11,"ﲈ","فِى","word"],[11,"ﲉ","حُجُورِكُم","word"],[11,"ﲊ","مِّن","word"],[11,"ﲋ","نِّسَآئِكُمُ","word"],[12,"ﲌ","ٱلَّـٰتِى","word"],[12,"ﲍ","دَخَلْتُم","word"],[12,"ﲎ","بِهِنَّ","word"],[12,"ﲏ","فَإِن","word"],[12,"ﲐ","لَّمْ","word"],[12,"ﲑ","تَكُونُوا۟","word"],[12,"ﲒ","دَخَلْتُم","word"],[12,"ﲓ","بِهِنَّ","word"],[12,"ﲔ","فَلَا","word"],[13,"ﲕ","جُنَاحَ","word"],[13,"ﲖ","عَلَيْكُمْ","word"],[13,"ﲗ","وَحَلَـٰٓئِلُ","word"],[13,"ﲘ","أَبْنَآئِكُمُ","word"],[13,"ﲙ","ٱلَّذِينَ","word"],[13,"ﲚ","مِنْ","word"],[14,"ﲛ","أَصْلَـٰبِكُمْ","word"],[14,"ﲜ","وَأَن","word"],[14,"ﲝ","تَجْمَعُوا۟","word"],[14,"ﲞ","بَيْنَ","word"],[14,"ﲟ","ٱلْأُخْتَيْنِ","word"],[14,"ﲠ","إِلَّا","word"],[15,"ﲡ","مَا","word"],[15,"ﲢ","قَدْ","word"],[15,"ﲣﲤ","سَلَفَ ۗ","word"],[15,"ﲥ","إِنَّ","word"],[15,"ﲦ","ٱللَّهَ","word"],[15,"ﲧ","كَانَ","word"],[15,"ﲨ","غَفُورًۭا","word"],[15,"ﲩ","رَّحِيمًۭا","word"],[15,"ﲪ","٢٣","end"]]}]}